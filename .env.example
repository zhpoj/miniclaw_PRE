# 复制为 .env 后生效（compose 会自动读取）
# agent 的工作区：宿主机任意路径，会挂到容器内 /workspace
WORKSPACE_PATH=./workspace

# 也可指向仓库外的项目，例如：
# WORKSPACE_PATH=D:/code/my-project
# WORKSPACE_PATH=/home/me/code/my-project

# 执行模式：host = agent 在宿主机进程里跑；container = 在容器里跑（默认自动识别，有 /.dockerenv 即 container）
# AGENT_EXEC_MODE=host

# ---- IM 通道（可选，配了才挂载；一个会话 = 一个 agent run）----
# 飞书自建应用：开放平台后台拿 App ID / App Secret，Encrypt Key 用于签名校验 + 事件解密
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=xxx
# FEISHU_ENCRYPT_KEY=xxx            # 不配则跳过签名校验与解密
# FEISHU_RECEIVE_ID_TYPE=chat_id    # 或 open_id
# FEISHU_BASE_URL=https://open.feishu.cn
# 默认使用官方长连接，无需公网地址；如需 HTTP 回调可改为 webhook
# FEISHU_CONNECTION_MODE=websocket

# Webhook 回调地址填到飞书后台：https://<你的域名>/api/im/feishu/webhook

# IM 桥接行为微调
# IM_TURN_TIMEOUT_MS=600000   # 单个任务多久没跑完就报错（0 = 不限制）
# IM_MAX_QUEUE=3              # 任务执行中最多排几条消息
# IM_MAX_CONVERSATIONS=50     # 同时保留多少个会话
# IM_MAX_REPLY_CHARS=4000     # 单条回复最大字数，超出会截断
# IM_STREAMING=1              # 打开后回复以卡片形式边写边更新
# IM_STREAM_INTERVAL_MS=1500  # 流式更新的最小间隔
